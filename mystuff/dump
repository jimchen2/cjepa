    max_n_objects = 3  # MUST BE NUM_SLOTS - 1
    max_question_len = {q_pad}
    max_choice_len = {c_pad}
    shuffle_obj = False
    train_batch_size = 96
    val_batch_size = train_batch_size * 2
    num_workers = 4

    model = 'CLEVRERAloe'
    transformer_dict = dict(
        input_len=(max_n_objects + 1) * n_sample_frames + max_question_len + max_choice_len,
