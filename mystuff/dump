#### Step 5: Convert Pendulum VQA Schema, Build Vocab, & Generate ALOE Config
```bash
python - <<'PY'
import json, os, shutil
from pathlib import Path

home = Path.home()
raw_dir = home / "Downloads/pendulum_output/pendulum-cjepa-3k-new"
aloe_data_root = home / "Downloads/pendulum_output/aloe_data"
(aloe_data_root / "questions").mkdir(parents=True, exist_ok=True)

q_words, a_answers = set(), set()
max_q_len = max_c_len = 0

def tok(s):
    return [w for w in s.lower().replace('?', '').split(' ') if w]

video_fn2path = {"train": {}, "val": {}, "test": {}}

for split in ["train", "val"]:
    with open(raw_dir / "questions" / f"questions_{split}.json") as f:
        raw = json.load(f)
    scenes = raw["scene_annotation"] if isinstance(raw, dict) else raw

    out_scenes = []
    for scene in scenes:
        vid_fn = os.path.basename(scene["video_filename"])
        scene_idx = int(vid_fn.split("_")[1].split(".")[0])
        video_fn2path[split][vid_fn] = str(raw_dir / "videos" / split / vid_fn)

        out_qs = []
        for q in scene["questions"]:
            qtype, q_str = q["question_type"], q["question"]
            q_tokens = tok(q_str)
            q_words.update(q_tokens)
            max_q_len = max(max_q_len, len(q_tokens))

            if qtype == "descriptive":
                ans = q["answer"]
                ans = str(q["choices"][ans]) if ("choices" in q and isinstance(ans, int)) else str(ans)
                a_answers.add(ans)
                out_qs.append({
                    "question_id": q["question_id"],
                    "question_type": "descriptive",
                    "question": q_str,
                    "answer": ans,
                })
            else:
                ans_idx = int(q["answer"])
                choices_out = []
                for cid, c_str in enumerate(q["choices"]):
                    c_str = str(c_str)
                    c_tokens = tok(c_str)
                    q_words.update(c_tokens)
                    max_c_len = max(max_c_len, len(c_tokens))
                    choices_out.append({
                        "choice_id": cid,
                        "choice": c_str,
                        "answer": "correct" if cid == ans_idx else "wrong",
                    })
                out_qs.append({
                    "question_id": q["question_id"],
                    "question_type": qtype,
                    "question": q_str,
                    "choices": choices_out,
                })

        out_scenes.append({"scene_index": scene_idx, "video_filename": vid_fn, "questions": out_qs})

    with open(aloe_data_root / "questions" / f"{split}.json", "w") as f:
        json.dump(out_scenes, f)

q_vocab = {"PAD": 0}
for w in sorted(q_words):
    if w not in q_vocab:
        q_vocab[w] = len(q_vocab)
a_vocab = {a: i for i, a in enumerate(sorted(a_answers))}

vocab_path = aloe_data_root / "pendulum_vocab.json"
with open(vocab_path, "w") as f:
    json.dump({"q_vocab": q_vocab, "a_vocab": a_vocab}, f, indent=2)

cache_file = home / "Downloads/cjepa/src/third_party/slotformer/clevrer_vqa/datasets/cache/CLEVRER_video_fn2video_path.json"
backup_file = cache_file.with_suffix(".json.bak")
if cache_file.exists() and not backup_file.exists():
    shutil.copy2(cache_file, backup_file)
with open(cache_file, "w") as f:
    json.dump(video_fn2path, f)

q_pad, c_pad = max_q_len + 4, max_c_len + 4
cfg_path = home / "Downloads/cjepa/src/third_party/slotformer/clevrer_vqa/configs/aloe_pendulum_params_rollout.py"
cfg_path.write_text(f"""import os
from nerv.training import BaseParams

class SlotFormerParams(BaseParams):
    project = 'SlotFormer_Pendulum'
    gpus = 1
    max_epochs = 100
    eval_interval = 5
